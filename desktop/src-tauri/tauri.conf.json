{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SAM3DBody Desktop",
  "version": "0.1.2",
  "identifier": "com.sam3dbody.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SAM3DBody Desktop",
        "width": 1220,
        "height": 820,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$DOWNLOAD/**",
          "$DOCUMENT/**",
          "$VIDEO/**",
          "$PICTURE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "resources": ["resources/engine/*", "resources/templates/*"]
  }
}
